server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The read API lives on singularity-platform. Proxying it keeps the app and
    # its data on one origin, so there is no CORS and no API URL in the browser.
    location /api/ {
        proxy_pass ${SINGULARITY_API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Single-page app: /m/<uuid> and other routes are handled in the browser.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hero, item and map images come from the public Deadlock assets CDN until
    # they are mirrored locally.
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; style-src 'self'; font-src 'self'; script-src 'self'; img-src 'self' data: https://assets-bucket.deadlock-api.com; frame-ancestors 'none'; base-uri 'self'" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
}

# Sample matches from fixtures/api, for previewing the app before the platform
# serves the read API (platform issue #9). Only reachable from inside the
# container. Use it with SINGULARITY_API_UPSTREAM=http://127.0.0.1:8090.
server {
    listen 127.0.0.1:8090;
    root /usr/share/nginx/fixtures;
    default_type application/json;

    location = /api/matches {
        try_files /api/matches.json =404;
    }
    location ~ ^/api/matches/([0-9a-f-]+)$ {
        try_files /api/matches/$1.json =404;
    }
    location / {
        return 404;
    }
}
